# NOTE ON DEPLOYMENT: These variables are for LOCAL runs (.env). In AWS, the same values are
# set on the Lambda as environment variables by the AWS SAM stack (template.yaml). The secret
# ones (WEBHOOK_PATH_TOKEN, NOTION_KEY, SUPABASE_KEY, OPENAI_API_KEY, EXA_API_KEY,
# LOGFIRE_TOKEN) are NoEcho CloudFormation parameters supplied from the gitignored
# params/prod.json (copy params/prod.example.json). Never commit real secrets.

# Notion API
NOTION_KEY=secret_xxx
NOTION_MAIN_DB_ID=xxx
NOTION_PROCESS_DASHBOARD_DB_ID=xxx
NOTION_GUIDELINES_DB_ID=xxx
NOTION_REFERENCES_DB_ID=xxx
NOTION_CONFIDENTIAL_DB_ID=xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=xxx

# OpenAI
OPENAI_API_KEY=sk-xxx

# Exa.ai (Optional: enables LinkedIn enrichment)
EXA_API_KEY=xxx

# Logfire (Optional: enables OpenAI tracing)
LOGFIRE_TOKEN=xxx

# Logging
# Set to DEBUG for full traceability (webhook routing, handler dispatch, registry lookups)
LOG_LEVEL=INFO

# Webhook Security — shared-secret URL path token (REQUIRED for Function URL)
# Notion automation webhooks are UNSIGNED (no HMAC header), so the Function URL
# is authenticated by a long random token embedded in the URL path:
#   https://<function-url-host>/<WEBHOOK_PATH_TOKEN>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# FAIL CLOSED: if this is unset/empty, ALL Function-URL requests are rejected (401).
# Set the SAME value here and in the Lambda env, and paste the full URL (with the
# token path segment) into every Notion automation's "Send webhook" action.
WEBHOOK_PATH_TOKEN=

# Webhook Feature Flags (set to "true" to enable, default: disabled)
WEBHOOK_PROCESS_DASHBOARD_ENABLED=false
WEBHOOK_MAIN_CANDIDATE_ENABLED=false
WEBHOOK_CENTRAL_REFERENCE_ENABLED=false
WEBHOOK_WORKFLOW_ENABLED=false
# Form-direct candidate intake: new Workflow pages (CV attached, no AUX Form) are
# routed to the Harvester (apply template + process CV). Requires WEBHOOK_WORKFLOW_ENABLED=true.
WEBHOOK_WORKFLOW_INTAKE_ENABLED=false
WEBHOOK_FEEDBACK_ENABLED=false
WEBHOOK_FORM_SUBMISSION_ENABLED=false
WEBHOOK_BULK_SUBMISSION_ENABLED=false
WEBHOOK_OUTCOME_ENABLED=false

# Observer Configuration
OBSERVER_LOOKBACK_MINUTES=11

# Confidential Process Support
# Notion permission group IDs (comma-separated). Combined membership = all team members.
# Covers: Nzyme Strategy and Growth, Partners, Investment Team, Value Creation Team
NOTION_ALL_TEAM_GROUP_IDS=<comma-separated group UUIDs>
