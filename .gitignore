# Archivos de entorno y secretos (¡CRÍTICO!)
.env

# Archivos temporales de Python
__pycache__/
*.py[cod]

# Carpetas de entorno virtual
venv/
env/
.venv/

# Carpetas temporales de tu script (para que no se suban los PDFs)
temp_downloads/
tmp/

# Log files
logs/

# Archivos de sistema/editor
.DS_Store
.vscode/
.claude/

# Lambda build artifacts
package/
lambda.zip

# AWS SAM / CloudFormation IaC
# Build output and packaged (S3-rewritten) templates
.aws-sam/
packaged.yaml
# CloudFormation parameter overrides — real files CONTAIN SECRETS, never commit.
# Ignore everything under params/ except the secret-free example.
params/*
!params/*.example.json
# Full live-config backups — env-var dumps CONTAIN SECRETS, never commit
infra-backup/

# Local scratch artifacts
nzyme-talent-management.zip
cwli_results.json